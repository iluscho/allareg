# ── Telegram ──────────────────────────────────────────────────────────────────

# Токен бота от @BotFather. Без него API работает, но уведомления не приходят.
BOT_TOKEN=

# Telegram ID администраторов через запятую. Узнать: напишите боту /id.
# Пример: 123456789,987654321
ADMIN_IDS=

# ── Cloudflare Workers (бесплатный вариант) ───────────────────────────────────

# Адрес воркера после npx wrangler deploy, например:
# https://allareg-bot.ваш-аккаунт.workers.dev
WEBHOOK_URL=

# Тот же секрет, что задан командой: npx wrangler secret put WEBHOOK_SECRET
# (не короче 16 символов)
WEBHOOK_SECRET=

# ── Сайт и API ────────────────────────────────────────────────────────────────

# Порт и адрес HTTP-сервера
PORT=8080
HOST=0.0.0.0

# Адрес сайта (для подписи в боте)
SITE_URL=https://regressional.ru

# Кто может отправлять заявки через API. "*" — любой сайт (форма публичная).
ALLOWED_ORIGINS=*

# Включите 1, если сервер стоит за Nginx/Caddy/Cloudflare,
# иначе ограничение частоты будет считать все заявки одним IP.
TRUST_PROXY=0

# ── Хранилище ─────────────────────────────────────────────────────────────────

# Каталог с schedule.json и requests.json
DATA_DIR=data

# Откуда взять расписание при первом запуске
SEED_SCHEDULE=schedule.json

# ── Прочее ────────────────────────────────────────────────────────────────────

# Часовой пояс для дат в сообщениях бота
TZ_NAME=Europe/Moscow

# Лимит заявок с одного IP: не больше N за WINDOW мс (по умолчанию 5 за 10 минут)
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000

# debug | info | warn | error
LOG_LEVEL=info
